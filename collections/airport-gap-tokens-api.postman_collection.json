                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<email>\",\n  \"password\": \"<password>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
